{
    "name": "ornitophp/starter",
    "description": "Starter template for OrnitoPHP — a tiny educational PHP framework.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ornitophp/framework": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": "php -S localhost:8080 -t public",
        "test": "phpunit",
        "post-create-project-cmd": [
            "php bin/ornito migrate",
            "php bin/ornito db:seed"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable"
}
